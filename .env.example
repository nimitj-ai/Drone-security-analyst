# .env.example — copy to .env and fill in values

# VLM backend: mock | blip2 | florence2
VLM_BACKEND=mock

# Embedding backend: mock | clip
EMBED_BACKEND=mock

# Vector store backend: mock | lancedb
VECTOR_BACKEND=mock

# LangChain LLM backend: mock | openai
LANGCHAIN_LLM=mock

# OpenAI API key (required if LANGCHAIN_LLM=openai)
# OPENAI_API_KEY=sk-...
